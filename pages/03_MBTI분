import streamlit as st
import pandas as pd
import plotly.graph_objects as go

# 1. 페이지 레이아웃 설정
st.set_page_config(
    page_title="국가별 MBTI 분석 대시보드",
    page_icon="📊",
    layout="wide"
)

st.title("📊 국가별 MBTI 분포 시각화 대시보드")
st.markdown("데이터셋에서 국가를 선택하면 16가지 MBTI 유형의 비율을 맞춤형 막대그래프로 보여줍니다.")

# 2. 데이터 로드 (캐싱으로 성능 최적화)
@st.cache_data
def load_data():
    df = pd.read_csv("countriesMBTI_16types.csv")
    # 소수점 데이터를 직관적인 퍼센트(%) 단위를 위해 100을 곱함
    mbti_cols = df.columns[1:]
    df[mbti_cols] = df[mbti_cols] * 100
    return df, list(mbti_cols)

try:
    df, mbti_types = load_data()
except FileNotFoundError:
    st.error("❌ `countriesMBTI_16types.csv` 파일이 스크립트와 같은 폴더에 있는지 확인해 주세요.")
    st.stop()

# 3. 사이드바 - 국가 선택 인터페이스
st.sidebar.header("🗺️ 국가 설정")
country_list = sorted(df['Country'].unique())
# 데이터에 South Korea가 있다면 기본값으로 설정, 없으면 첫 번째 국가
default_idx = country_list.index("South Korea") if "South Korea" in country_list else 0
selected_country = st.sidebar.selectbox("분석할 국가를 선택하세요:", country_list, index=default_idx)

# 4. 데이터 가공 (선택된 국가의 MBTI 비율 내림차순 정렬)
country_data = df[df['Country'] == selected_country].iloc[0]
sorted_mbti = country_data[mbti_types].sort_values(ascending=False)

mbti_labels = sorted_mbti.index.tolist()
mbti_values = sorted_mbti.values.tolist()

# 5. 그래프 색상 지정 로직 (1등: 노란색, 나머지: 하늘색에서 투명해지는 그라데이션)
# 총 16개 유형이므로 1등을 제외한 15개 막대에 투명도(opacity)를 차등 부여합니다.
colors = []
for i in range(16):
    if i == 0:
        colors.append("rgba(255, 215, 0, 1.0)")  # 1등: 진한 노란색 (Gold)
    else:
        # 2등(최고 선명도)부터 16등(최저 선명도)까지 알파(투명도) 값을 0.9에서 0.15까지 서서히 낮춤
        opacity = 0.9 - (i - 1) * (0.75 / 14)
        colors.append(f"rgba(135, 206, 250, {opacity})")  # 하늘색 (LightSkyBlue) 기반 그라데이션

# 6. Plotly 고급 막대그래프 생성
fig = go.Figure()
fig.add_trace(go.Bar(
    x=mbti_labels,
    y=mbti_values,
    marker_color=colors,
    text=[f"{val:.2f}%" for val in mbti_values],
    textposition='outside',
    hoverinfo='x+y'
))

# 그래프 레이아웃 다듬기
fig.update_layout(
    title=f"<b>{selected_country}의 MBTI 유형별 비율 순위</b>",
    title_font_size=20,
    xaxis=dict(title="MBTI 유형", title_font_size=14, tickfont_size=12),
    yaxis=dict(title="비율 (%)", title_font_size=14, tickfont_size=12, range=[0, max(mbti_values) * 1.15]),
    margin=dict(l=40, r=40, t=60, b=40),
    height=550,
    plot_bgcolor='rgba(0,0,0,0)',  # 깔끔한 흰색 배경
    paper_bgcolor='rgba(0,0,0,0)'
)

# 축 그리드 라인 스타일 추가
fig.update_yaxes(showgrid=True, gridwidth=1, gridcolor='rgba(200, 200, 200, 0.3)')

# 7. 화면 배치
col1, col2 = st.columns([3, 1])

with col1:
    st.plotly_chart(fig, use_container_width=True)

with col2:
    st.subheader("📋 요약 정보")
    st.write(f"**선택된 국가:** {selected_country}")
    st.info(f"🏆 가장 많은 유형: **{mbti_labels[0]}** ({mbti_values[0]:.2f}%)")
    st.warning(f"❄️ 가장 희귀한 유형: **{mbti_labels[-1]}** ({mbti_values[-1]:.2f}%)")
    
    # 세부 순위 표 출력
    st.markdown("**전체 데이터 순위**")
    rank_df = pd.DataFrame({
        'MBTI': mbti_labels,
        '비율': [f"{v:.2f}%" for v in mbti_values]
    })
    rank_df.index = rank_df.index + 1
    st.dataframe(rank_df, use_container_width=True)
