import streamlit as st
import pandas as pd
import plotly.graph_objects as go

# 1. 페이지 레이아웃 설정
st.set_page_config(
    page_title="세계 MBTI 통계 대시보드",
    page_icon="🌍",
    layout="wide"
)

st.title("🌍 세계 MBTI 분포 & 순위 대시보드")
st.markdown("국가별 MBTI 비율 순위와 MBTI별 국가 순위를 초록색 그라데이션 그래프로 확인해 보세요.")

# 2. 데이터 로드 (캐싱으로 성능 최적화)
@st.cache_data
def load_data():
    df = pd.read_csv("countriesMBTI_16types.csv")
    # 소수점 데이터를 직관적인 퍼센트(%) 단위를 위해 100을 곱함
    mbti_cols = df.columns[1:]
    df[mbti_cols] = df[mbti_cols] * 100
    return df, list(mbti_cols)

try:
    df, mbti_types = load_data()
except FileNotFoundError:
    st.error("❌ `countriesMBTI_16types.csv` 파일이 스크립트와 같은 폴더에 있는지 확인해 주세요.")
    st.stop()

# 3. 사이드바 - 분석 기능 선택
st.sidebar.header("⚙️ 기능 선택")
analysis_mode = st.sidebar.radio(
    "원하는 분석을 선택하세요:",
    ["1. 국가별 MBTI 비율 (1등부터)", "2. MBTI별 상위 10개국 (1등부터)"]
)

# --- [기능 1] 국가별 MBTI 비율 (1등부터 출력) ---
if analysis_mode == "1. 국가별 MBTI 비율 (1등부터)":
    st.subheader("📊 국가별 MBTI 비율 순위")
    
    country_list = sorted(df['Country'].unique())
    default_idx = country_list.index("South Korea") if "South Korea" in country_list else 0
    selected_country = st.selectbox("분석할 국가를 선택하세요:", country_list, index=default_idx)
    
    # 데이터 가공 (선택된 국가의 MBTI 비율 내림차순 정렬)
    country_data = df[df['Country'] == selected_country].iloc[0]
    sorted_mbti = country_data[mbti_types].sort_values(ascending=False)
    
    mbti_labels = sorted_mbti.index.tolist()
    mbti_values = sorted_mbti.values.tolist()
    
    # 초록색 그라데이션 색상 지정 (1등이 가장 진하고 뒤로 갈수록 흐려짐)
    # 총 16개 유형이므로 알파(투명도) 값을 1.0에서 0.15까지 차등 부여
    colors = []
    for i in range(16):
        opacity = 1.0 - i * (0.85 / 15)
        colors.append(f"rgba(34, 139, 34, {opacity})")  # ForestGreen 기반 그라데이션
        
    # Plotly 막대그래프 생성
    fig = go.Figure()
    fig.add_trace(go.Bar(
        x=mbti_labels,
        y=mbti_values,
        marker_color=colors,
        text=[f"{val:.2f}%" for val in mbti_values],
        textposition='outside',
        hoverinfo='x+y'
    ))
    
    fig.update_layout(
        title=f"<b>{selected_country}의 MBTI 유형별 비율 (1등부터 순위)</b>",
        title_font_size=18,
        xaxis=dict(title="MBTI 유형", tickfont_size=12),
        yaxis=dict(title="비율 (%)", range=[0, max(mbti_values) * 1.15]),
        height=500,
        plot_bgcolor='rgba(0,0,0,0)'
    )
    fig.update_yaxes(showgrid=True, gridwidth=1, gridcolor='rgba(200, 200, 200, 0.3)')
    
    # 레이아웃 배치
    col1, col2 = st.columns([3, 1])
    with col1:
        st.plotly_chart(fig, use_container_width=True)
    with col2:
        st.markdown(f"### 📋 {selected_country} 요약")
        st.success(f"🥇 **1등 유형:** {mbti_labels[0]} ({mbti_values[0]:.2f}%)")
        
        rank_df = pd.DataFrame({'MBTI': mbti_labels, '비율': [f"{v:.2f}%" for v in mbti_values]})
        rank_df.index = rank_df.index + 1
        st.dataframe(rank_df, use_container_width=True)


# --- [기능 2] MBTI별 상위 10개국 (1등부터 출력) ---
elif analysis_mode == "2. MBTI별 상위 10개국 (1등부터)":
    st.subheader("🗺️ 특정 MBTI 비율이 높은 상위 10개국")
    
    selected_mbti = st.selectbox("분석할 MBTI 유형을 선택하세요:", mbti_types)
    
    # 데이터 가공 (선택된 MBTI 기준 내림차순 정렬 후 상위 10개국 추출)
    mbti_rank = df[['Country', selected_mbti]].sort_values(by=selected_mbti, ascending=False).head(10).reset_index(drop=True)
    
    country_labels = mbti_rank['Country'].tolist()
    country_values = mbti_rank[selected_mbti].tolist()
    
    # 초록색 그라데이션 색상 지정 (상위 10개국 대상, 1등이 가장 진함)
    # 총 10개 국가이므로 알파(투명도) 값을 1.0에서 0.3까지 차등 부여
    colors = []
    for i in range(10):
        opacity = 1.0 - i * (0.7 / 9)
        colors.append(f"rgba(46, 139, 87, {opacity})")  # SeaGreen 기반 그라데이션

    # Plotly 막대그래프 생성
    fig = go.Figure()
    fig.add_trace(go.Bar(
        x=country_labels,
        y=country_values,
        marker_color=colors,
        text=[f"{val:.2f}%" for val in country_values],
        textposition='outside',
        hoverinfo='x+y'
    ))
    
    fig.update_layout(
        title=f"<b>{selected_mbti} 비율이 가장 높은 국가 Top 10 (1등부터)</b>",
        title_font_size=18,
        xaxis=dict(title="국가", tickfont_size=12),
        yaxis=dict(title="비율 (%)", range=[0, max(country_values) * 1.15]),
        height=500,
        plot_bgcolor='rgba(0,0,0,0)'
    )
    fig.update_yaxes(showgrid=True, gridwidth=1, gridcolor='rgba(200, 200, 200, 0.3)')
    
    # 레이아웃 배치
    col1, col2 = st.columns([3, 1])
    with col1:
        st.plotly_chart(fig, use_container_width=True)
    with col2:
        st.markdown(f"### 📋 {selected_mbti} 탑 10 국가")
        
        rank_df = pd.DataFrame({'국가': country_labels, '비율': [f"{v:.2f}%" for v in country_values]})
        rank_df.index = rank_df.index + 1
        st.dataframe(rank_df, use_container_width=True)
